# Copy to .env and edit.

# Channel timezone. The grid aligns to this wall clock, so it decides what
# "11:30" means for your viewers. Keep this in step with
# `channel.grid.timezone` in config/channel.yaml -- they are separate settings
# because one configures the container's clock and the other the schedule.
TZ=Asia/Tokyo

# Where your media lives, on the host. Mounted read-only into both containers.
MEDIA_DIR=./media

# The bump renderer writes into the media tree, so that folder is mounted
# read-write. Point it inside MEDIA_DIR.
GENERATED_BUMP_DIR=./media/bumps/generated

# Published HLS proxy / stream port
ETV_PORT=8409
# ErsatzTV Next
# Pin this once you have a build you trust, e.g. v0.2.3
ETV_TAG=latest

# How often the scheduler rebuilds the plan (seconds). Six hours is plenty for a
# three-day horizon; lower it while you are tuning.
PLAN_INTERVAL_SECONDS=21600

# Render generated bump cards on each cycle. Leave false once the cache exists;
# rendering is deterministic and cached, so it only costs time.
GENERATE_BUMPS=false

# Only used with `docker compose --profile plex up -d`
DISPATCHARR_PORT=9191
